# Copie para .env (nunca commitar). Em produção, configure na Vercel.

# Token que o HC Webhook envia no header x-api-key
INGEST_TOKEN=

# Supabase — a service role só existe no servidor (/api), nunca no front
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# UUID do seu usuário em auth.users (dono dos dados ingeridos)
INGEST_USER_ID=
